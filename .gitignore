# --- Hak data (D-015, U7, U13) -------------------------------------------------
# Data mentah PIHPS/JISDOR/BPS/Bapanas/Comtrade tidak boleh diredistribusi; dibagikan lewat Drive / dataset Kaggle PRIVAT.
data/raw/*
!data/raw/checksums.csv
# tabel regulasi buatan tim (CC BY 4.0) tetap di-track
!data/raw/manual_regulation/
data/raw/_redownload/

# Turunan yang memuat level harga PIHPS per provinsi + artefak hasil generate.
# Ditukar lewat folder Drive bersama / output Kaggle (PEMBAGIAN_TUGAS §5), bukan git.
data/interim/
data/processed/*
# Dua artefak turunan yang dibaca app (halaman Rupiah dari waktu ke waktu & Profil provinsi, D-175) di-track agar app
# daring tidak "Menunggu hasil" (D-176). Keduanya ship=True: izin BI mencakup redistribusi data turunan (D-104).
!data/processed/drivers_weekly.parquet
!data/processed/panel_weekly.parquet
results/*
# ditulis manual oleh Abi (WP-33) tetap di-track
!results/findings.md
# Artefak ship=True yang dibaca app (± 1,4 MB) di-track agar Streamlit Community Cloud menampilkan hasil (D-135).
# Semuanya boleh dikirim (ship=True, D-104). Artefak yang tidak dibaca app (boot_replicates & placebo_stats 14 MB,
# fx_variation, data/processed) tetap lewat Drive tim / zip juri.
!results/robustness.csv
!results/stage0/
results/stage0/*
!results/stage0/eligibility.csv
!results/stage0/episodes.csv
!results/stage0/mde.csv
!results/stage0/stage0_report.md
!results/task1/
results/task1/*
!results/task1/profiles.parquet
!results/task1/events.parquet
!results/task1/response_features.parquet
!results/task2/
!results/task3/
!results/task4/
results/task4/*
!results/task4/forecast_eval.csv
!results/task4/ablation.csv

